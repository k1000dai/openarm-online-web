# Base URL of the OpenArm Online API server
OPENARM_ONLINE_API_URL=http://app:8000

# API key sent as the X-API-KEY header to the OpenArm Online API (required)
OPENARM_ONLINE_API_KEY=xxx

# Comma-separated IDs of the tasks to serve teleoperation for (required).
# Tasks are polled in the listed order.
OPENARM_ONLINE_TASK_IDS=1

# The server is teleoperation only and has no job queue endpoints, so
# keep job polling disabled.
JOBS_ENABLED=false

# Interval in seconds between polls for a teleoperation offer
#POLL_INTERVAL=3

# Timeout in seconds for a teleoperation session (dora run)
#TELEOPERATE_TIMEOUT=300

# Directory for runner state files such as the not_ready marker
#STATE_DIRECTORY=state

# Teleoperation dataflow files. The image defaults to the MuJoCo
# pedestal dataflows; point these at
# /runner/dataflows/teleoperation/{keyboard,webxr}/pedestal/dataflow.yaml
# to drive the real pedestal robot.
#DEFAULT_KEYBOARD_TELEOPERATION_DATAFLOW_FILE=/runner/dataflows/teleoperation/keyboard/pedestal-mujoco/dataflow.yaml
#DEFAULT_WEBXR_TELEOPERATION_DATAFLOW_FILE=/runner/dataflows/teleoperation/webxr/pedestal-mujoco/dataflow.yaml

# Time window (HH:MM) in which the runner serves teleoperation; outside
# of it the runner only sleeps. Both must be set to take effect. A
# window crossing midnight (e.g. start=22:00, end=06:00) is also
# supported.
#ACTIVE_TIME_START=08:00
#ACTIVE_TIME_END=17:00
